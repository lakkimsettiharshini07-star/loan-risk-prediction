# Virtual environment
.venv/
venv/

# Raw and processed data (never commit datasets)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Uploaded documents (personal data)
uploads/*
!uploads/.gitkeep

# Database (will contain applicant data)
*.db
*.sqlite
*.sqlite3

# Secrets
.env
*.key

# Python and Jupyter clutter
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# VS Code local settings
.vscode/